+static size_t server_prompt_cache_prompt_fixed_bytes(const server_prompt & prompt) {
+    // Include the cache state/list node and one node per copied checkpoint. The
+    // token-vector capacity and checkpoint payload capacities are added separately.
+    size_t bytes = sizeof(server_prompt_cache_state) + 4 * sizeof(void *);
+    const size_t checkpoint_nodes = server_prompt_cache_policy::capacity_bytes(
+            prompt.checkpoints.size(), sizeof(common_prompt_checkpoint) + 4 * sizeof(void *));
+    return server_prompt_cache_policy::add_bytes(bytes, checkpoint_nodes);
+}
+
+static size_t server_prompt_cache_checkpoint_payload_bytes(const server_prompt & prompt) {
+    size_t bytes = 0;
+    for (const auto & checkpoint : prompt.checkpoints) {
+        bytes = server_prompt_cache_policy::add_bytes(
+                bytes,
+                server_prompt_cache_policy::capacity_bytes(checkpoint.data_tgt.capacity(), sizeof(uint8_t)));
+        bytes = server_prompt_cache_policy::add_bytes(
+                bytes,
+                server_prompt_cache_policy::capacity_bytes(checkpoint.data_dft.capacity(), sizeof(uint8_t)));
+        bytes = server_prompt_cache_policy::add_bytes(
+                bytes,
+                server_prompt_cache_policy::capacity_bytes(checkpoint.data_spec.capacity(), sizeof(uint8_t)));
+    }
+    return bytes;
+}
+
+static size_t server_prompt_cache_checkpoint_footprint(const server_prompt & prompt) {
+    const size_t checkpoint_metadata_bytes = server_prompt_cache_policy::capacity_bytes(
+            prompt.checkpoints.size(), sizeof(common_prompt_checkpoint) + 4 * sizeof(void *));
+    return server_prompt_cache_policy::add_bytes(
+            checkpoint_metadata_bytes,
+            server_prompt_cache_checkpoint_payload_bytes(prompt));
+}
+
+size_t server_prompt_cache_state::size() const {
+    const size_t token_bytes = server_prompt_cache_policy::capacity_bytes(
+            prompt.tokens.get_tokens().capacity(), sizeof(llama_token));
+    return server_prompt_cache_policy::owned_bytes(
+            server_prompt_cache_prompt_fixed_bytes(prompt),
+            token_bytes,
+            server_prompt_cache_policy::capacity_bytes(data.main.capacity(), sizeof(uint8_t)),
+            server_prompt_cache_policy::capacity_bytes(data.drft.capacity(), sizeof(uint8_t)),
+            server_prompt_cache_policy::capacity_bytes(data.spec.capacity(), sizeof(uint8_t)),
+            server_prompt_cache_policy::add_bytes(
