+struct ggml_cuda_graph_structural_stats {
+    size_t passes = 0;
+    size_t attempts = 0;
+    size_t builds = 0;
+    size_t reject_too_large = 0;
+    size_t reject_graph = 0;
+    size_t reject_external = 0;
+    size_t reject_missing = 0;
