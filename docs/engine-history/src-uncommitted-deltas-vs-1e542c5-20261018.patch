+    auto * dev = model.dev_layer(model.hparams.n_layer());
+    for (auto * backend : backend_ptrs) {
+        if (ggml_backend_get_device(backend) != dev ||
+                ggml_backend_buft_is_host(ggml_backend_get_default_buffer_type(backend))) {
+            continue;
