+    auto enable = [](int from, int to) {
+        CUDA_CHECK(cudaSetDevice(from));
+        const cudaError_t err = cudaDeviceEnablePeerAccess(to, 0);
+        if (err == cudaSuccess) return true;
+        (void) cudaGetLastError();
