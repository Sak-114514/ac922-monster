+        if (mode == 0) {
+            GGML_ASSERT(reason >= 0 && reason < 5);
+            const size_t reason_count = ++stats.fallback_calls[reason];
+            if (reason_count <= 2) {
+                fprintf(stderr, "CUDA graph fallback ctx=%p device=%d uid=%" PRIu64 " nodes=%d mode=eager reason=%s node=%.*s op=%s count=%zu\n",
