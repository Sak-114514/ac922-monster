+            n_seq_max() < 2 || n_seq_max() > 64 || n_seq_max() > cparams.n_ubatch ||
+            !cparams.embeddings_nextn || !cparams.embeddings_nextn_masked || cparams.pipeline_parallel) {
+        return false;
